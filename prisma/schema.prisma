// ============================================================================
// ZYROTRIP — Full Production Prisma Schema
// Database: PostgreSQL
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────



























// ─── Geography ──────────────────────────────────────────────────────────────

model Country {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String        @unique 
  continent    String
  flagUrl      String?
  destinations Destination[]
  regions      Region[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([continent])
  @@map("countries")
}

model Region {
  id           String        @id @default(cuid())
  name         String
  countryId    String
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  destinations Destination[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, countryId])
  @@index([countryId])
  @@map("regions")
}

// ─── Destinations ────────────────────────────────────────────────────────────

model DestinationCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  icon         String?
  description  String?
  destinations Destination[] @relation("DestinationCategories")
  createdAt    DateTime      @default(now())

  @@map("destination_categories")
}

model Destination {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  tagline         String?
  description     String
  longDescription String?
  heroImage       String
  countryId       String
  country         Country               @relation(fields: [countryId], references: [id])
  regionId        String?
  region          Region?               @relation(fields: [regionId], references: [id])
  categories      DestinationCategory[] @relation("DestinationCategories")
  priceFrom       Float               
  currency        String                @default("USD")
  rating          Float               @default(0) 
  reviewCount     Int                   @default(0)
  bestTimeToVisit String?
  climate         String?
  language        String?
  timezone        String?
  latitude        Float?              
  longitude       Float?              
  featured        Boolean               @default(false)
  trending        Boolean               @default(false)
  seasonal        Boolean               @default(false)
  published       Boolean               @default(true)
  // SEO
  seoTitle        String?
  seoDescription  String?
  // Relations
  images          DestinationImage[]
  hotels          Hotel[]
  experiences     Experience[]
  packages        TravelPackage[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  weatherCache    WeatherCache[]
  itineraries     Itinerary[]
  // Timestamps
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([countryId])
  @@index([featured])
  @@index([trending])
  @@index([published])
  @@index([rating])
  @@map("destinations")
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  url           String
  alt           String?
  caption       String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([destinationId, order])
  @@map("destination_images")
}

// ─── Hotels ──────────────────────────────────────────────────────────────────

model Hotel {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  destinationId  String
  destination    Destination    @relation(fields: [destinationId], references: [id])
  description    String
  stars          Int            
  heroImage      String
  images         HotelImage[]
  amenities      String /* JSON Array */
  address        String?
  latitude       Float?       
  longitude      Float?       
  rating         Float        @default(0) 
  reviewCount    Int            @default(0)
  priceFrom      Float        
  currency       String         @default("USD")
  featured       Boolean        @default(false)
  published      Boolean        @default(true)
  rooms          HotelRoom[]
  bookings       Booking[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  // SEO
  seoTitle       String?
  seoDescription String?
  // Timestamps
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([destinationId])
  @@index([stars])
  @@index([rating])
  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hotelId, order])
  @@map("hotel_images")
}

model HotelRoom {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  maxOccupancy  Int
  pricePerNight Float  
  images        String /* JSON Array */
  amenities     String /* JSON Array */
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hotelId])
  @@map("hotel_rooms")
}

// ─── Experiences ─────────────────────────────────────────────────────────────

model Experience {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  destinationId String
  destination   Destination    @relation(fields: [destinationId], references: [id])
  description   String
  duration      Int // minutes
  price         Float        
  currency      String         @default("USD")
  category      String
  heroImage     String
  images        String /* JSON Array */
  included      String /* JSON Array */
  maxGroupSize  Int?
  rating        Float        @default(0) 
  reviewCount   Int            @default(0)
  featured      Boolean        @default(false)
  published     Boolean        @default(true)
  wishlistItems WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([destinationId])
  @@index([category])
  @@map("experiences")
}

// ─── Travel Packages ─────────────────────────────────────────────────────────

model TravelPackage {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  destinationId      String
  destination        Destination     @relation(fields: [destinationId], references: [id])
  description        String
  longDescription    String?
  duration           Int // days
  priceFrom          Float         
  priceDiscount      Float?        
  currency           String          @default("USD")
  maxTravelers       Int
  category           String @default("CULTURAL")
  included           String /* JSON Array */
  excluded           String /* JSON Array */
  cancellationPolicy String?
  rating             Float         @default(0) 
  reviewCount        Int             @default(0)
  featured           Boolean         @default(false)
  published          Boolean         @default(true)
  // Relations
  images             PackageImage[]
  days               PackageDay[]
  bookings           Booking[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  // SEO
  seoTitle           String?
  seoDescription     String?
  // Timestamps
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  @@index([slug])
  @@index([destinationId])
  @@index([featured])
  @@index([category])
  @@map("travel_packages")
}

model PackageImage {
  id        String        @id @default(cuid())
  packageId String
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([packageId, order])
  @@map("package_images")
}

model PackageDay {
  id          String        @id @default(cuid())
  packageId   String
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String?
  activities  Activity[]
  createdAt   DateTime      @default(now())

  @@unique([packageId, dayNumber])
  @@index([packageId])
  @@map("package_days")
}

model Activity {
  id           String       @id @default(cuid())
  packageDayId String
  packageDay   PackageDay   @relation(fields: [packageDayId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  startTime    String?
  duration     Int? // minutes
  type         String @default("SIGHTSEEING")
  location     String?
  cost         Float?     
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([packageDayId])
  @@map("activities")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  emailVerified     DateTime?
  name              String?
  firstName         String?
  lastName          String?
  avatar            String?
  phone             String?
  passwordHash      String?
  role              String         @default("USER")
  // Preferences
  preferredCurrency String?          @default("USD")
  preferredLanguage String?          @default("en")
  newsletterOptIn   Boolean          @default(false)
  // Account status
  active            Boolean          @default(true)
  // Timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  // Relations
  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  wishlist          Wishlist?
  reviews           Review[]
  notifications     Notification[]
  itineraries       Itinerary[]
  searchHistory     SearchHistory[]
  couponUsages      CouponUsage[]
  referralsGiven    Referral[]       @relation("ReferrerUser")
  referralReceived  Referral?        @relation("ReferredUser")
  rewards           ReferralReward[]
  auditLogs         AuditLog[]       @relation("AuditUser")

  @@index([email])
  @@index([role])
  @@map("users")
}

// NextAuth.js v5 required models
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id                 String            @id @default(cuid())
  reference          String            @unique
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  packageId          String?
  package            TravelPackage?    @relation(fields: [packageId], references: [id])
  hotelId            String?
  hotel              Hotel?            @relation(fields: [hotelId], references: [id])
  status             String     @default("DRAFT")
  checkIn            DateTime
  checkOut           DateTime
  adults             Int               @default(1)
  children           Int               @default(0)
  infants            Int               @default(0)
  totalAmount        Float           
  discountAmount     Float           @default(0) 
  finalAmount        Float           
  currency           String            @default("USD")
  cancellationReason String?
  specialRequests    String?
  // Relations
  travelers          BookingTraveler[]
  payments           Payment[]
  invoice            Invoice?
  couponUsage        CouponUsage?
  // Timestamps
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([packageId])
  @@index([hotelId])
  @@map("bookings")
}

model BookingTraveler {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  passportNumber String?
  nationality    String?
  isLead         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([bookingId])
  @@map("booking_travelers")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                String          @id @default(cuid())
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id])
  provider          String
  providerPaymentId String?         @unique
  providerOrderId   String?
  amount            Float         
  currency          String          @default("USD")
  status            String   @default("PENDING")
  webhookVerified   Boolean         @default(false)
  failureReason     String?
  metadata          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

model Invoice {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  invoiceNumber String    @unique
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  items         String // line items
  subtotal      Float   
  discount      Float   @default(0) 
  total         Float   
  currency      String    @default("USD")
  createdAt     DateTime  @default(now())

  @@index([invoiceNumber])
  @@map("invoices")
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  description    String?
  type           String
  value          Float       
  minOrderAmount Float?      
  maxDiscount    Float?      
  maxUses        Int?
  usedCount      Int           @default(0)
  perUserLimit   Int           @default(1)
  expiresAt      DateTime?
  active         Boolean       @default(true)
  usages         CouponUsage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([code])
  @@index([active])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id])
  discountAmount Float  
  usedAt         DateTime @default(now())

  @@unique([couponId, userId, bookingId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id            String           @id @default(cuid())
  wishlistId    String
  wishlist      Wishlist         @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  type          String
  destinationId String?
  destination   Destination?     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  packageId     String?
  package       TravelPackage?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotelId       String?
  hotel         Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  experienceId  String?
  experience    Experience?      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@unique([wishlistId, destinationId])
  @@unique([wishlistId, packageId])
  @@unique([wishlistId, hotelId])
  @@unique([wishlistId, experienceId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  destinationId String?
  destination   Destination?   @relation(fields: [destinationId], references: [id])
  packageId     String?
  package       TravelPackage? @relation(fields: [packageId], references: [id])
  hotelId       String?
  hotel         Hotel?         @relation(fields: [hotelId], references: [id])
  rating        Int            
  title         String
  body          String
  images        String /* JSON Array */
  published     Boolean        @default(false)
  featured      Boolean        @default(false)
  adminResponse String?
  helpfulCount  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([destinationId])
  @@index([packageId])
  @@index([hotelId])
  @@index([published])
  @@map("reviews")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  actionUrl String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Itineraries ─────────────────────────────────────────────────────────────

model Itinerary {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  destinationId String?
  destination   Destination?    @relation(fields: [destinationId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  travelers     Int             @default(1)
  budget        Float?        
  currency      String          @default("USD")
  travelStyle   String?
  interests     String /* JSON Array */
  status        String @default("DRAFT")
  aiGenerated   Boolean         @default(false)
  shareToken    String?         @unique
  // Raw AI response cached
  aiContext     String?
  days          ItineraryDay[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([shareToken])
  @@map("itineraries")
}

model ItineraryDay {
  id          String              @id @default(cuid())
  itineraryId String
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  date        DateTime?
  title       String
  notes       String?
  activities  ItineraryActivity[]
  createdAt   DateTime            @default(now())

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@map("itinerary_days")
}

model ItineraryActivity {
  id             String       @id @default(cuid())
  itineraryDayId String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  time           String?
  title          String
  description    String?
  type           String @default("SIGHTSEEING")
  location       String?
  estimatedCost  Float?     
  duration       Int? // minutes
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([itineraryDayId])
  @@map("itinerary_activities")
}

// ─── Referrals ────────────────────────────────────────────────────────────────

model Referral {
  id          String           @id @default(cuid())
  referrerId  String
  referrer    User             @relation("ReferrerUser", fields: [referrerId], references: [id])
  referredId  String           @unique
  referred    User             @relation("ReferredUser", fields: [referredId], references: [id])
  code        String           @unique
  status      String   @default("PENDING")
  rewards     ReferralReward[]
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

model ReferralReward {
  id         String       @id @default(cuid())
  referralId String
  referral   Referral     @relation(fields: [referralId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  amount     Float      
  type       String // DISCOUNT, CREDIT
  status     String @default("PENDING")
  expiresAt  DateTime?
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([referralId])
  @@map("referral_rewards")
}

// ─── Search History ───────────────────────────────────────────────────────────

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query       String
  filters     String?
  resultCount Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("search_history")
}

// ─── Weather Cache ────────────────────────────────────────────────────────────

model WeatherCache {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  data          String
  cachedAt      DateTime    @default(now())
  expiresAt     DateTime

  @@unique([destinationId])
  @@index([expiresAt])
  @@map("weather_cache")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("AuditUser", fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  changes   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
